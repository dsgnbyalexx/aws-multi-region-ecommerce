# ---- Secrets & credentials (never commit) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
credentials
.aws/
kubeconfig
*.kubeconfig

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# ---- Node.js ----
node_modules/
npm-debug.log*
coverage/

# ---- Terraform ----
# State files can contain secrets (e.g. DB passwords) -> never commit
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# NOTE: .terraform.lock.hcl IS committed on purpose (pins provider versions)
