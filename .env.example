# Copy to .env for local development:  cp .env.example .env
# Values here are LOCAL-ONLY placeholders. Real secrets never go in Git.
NODE_ENV=development
LOG_LEVEL=info
# Port on YOUR computer for the web app (http://localhost:8080).
# Inside its container the app always listens on 3000.
APP_PORT=8080
# PGHOST/PGPORT are how tools on YOUR computer (tests, psql) reach the database
# container. 5433 avoids clashing with any PostgreSQL already on 5432.
# (The app container ignores these and talks to "db:5432" inside Docker.)
PGHOST=localhost
PGPORT=5433
PGDATABASE=shop
PGUSER=shop
PGPASSWORD=change-me-local-only
